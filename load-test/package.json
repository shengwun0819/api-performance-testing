{
  "name": "k6-load-test",
  "version": "1.0.0",
  "description": "k6 API load test scripts",
  "private": true,
  "scripts": {
    "test": "k6 run tests/api-load.test.js",
    "test:grafana": "k6 run --out influxdb=http://localhost:8087/k6 tests/api-load.test.js",
    "test:report": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=report/api-load.html k6 run tests/api-load.test.js",
    "test:report:grafana": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=report/api-load.html k6 run --out influxdb=http://localhost:8087/k6 tests/api-load.test.js",
    "build": "webpack",
    "test:bundled": "k6 run load_test/api_load_test.test.js",
    "test:bundled:grafana": "k6 run --out influxdb=http://localhost:8087/k6 load_test/api_load_test.test.js",
    "prebundled": "npm run build && npm run test:bundled",
    "prebundled:grafana": "npm run build && npm run test:bundled:grafana"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}